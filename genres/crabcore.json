  "common_keys": ["C# minor", "C minor", "D minor", "B minor"],
  "scales": ["minor", "phrygian", "harmonic_minor", "minor_pentatonic"],
  "tuning": "drop_c#",
  "layer_order": ["rhythm_guitar", "drums", "electronic_drums", "bass", "synth_bass", "chords", "pad", "lead", "melody"],
  "chord_progressions": [
    { "name": "verse-pedal", "roman": ["i", "i", "VI", "VII"], "weight": 1.0, "bars_per_chord": 1.0,
      "source": "Open-string chug verse, root moves to bVI / bVII on bars 3-4" },
    { "name": "verse-phrygian", "roman": ["i", "i", "II", "i"], "weight": 0.8, "bars_per_chord": 1.0,
      "source": "Phrygian b2 pedal (scale=phrygian)" },
    { "name": "pre-chorus-lift", "roman": ["VI", "VII", "VI", "VII"], "weight": 0.6, "bars_per_chord": 1.0,
      "source": "Build into the clean chorus" },
    { "name": "chorus-anthem", "roman": ["VI", "VII", "i", "III"], "weight": 1.0, "bars_per_chord": 1.0,
      "source": "Bright, major-leaning clean chorus over the relative major chords" },
    { "name": "chorus-trance", "roman": ["i", "VI", "III", "VII"], "weight": 0.8, "bars_per_chord": 1.0,
      "source": "i-VI-III-VII — the trance/electronicore staple (Melodigging)" },
    { "name": "dance-loop", "roman": ["i", "VI", "III", "VII"], "weight": 0.5, "bars_per_chord": 2.0,
      "source": "Euro-dance break loop, two bars per chord" },
    { "name": "breakdown-pedal", "roman": ["i"], "weight": 0.4, "bars_per_chord": 4.0,
      "source": "Breakdown on the open low string" },
    { "name": "breakdown-b2", "roman": ["i", "i", "i", "II"], "weight": 0.3, "bars_per_chord": 1.0,
      "source": "Breakdown with a b2 lurch (scale=phrygian)" }
  ],
  "voicing_style": "power_chords",
