{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midi-agent-skill/genre-profile",
  "title": "Genre Profile",
  "description": "Cacheable artifact produced by the music-theory research workflow. Consumed by composers/ to generate deterministic MIDI compositions.",
  "type": "object",
  "required": [
    "name",
    "tempo_range",
    "default_key",
    "scales",
    "chord_progressions",
    "drum_patterns",
    "song_sections",
    "instruments",
    "principles"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Slug, lowercase-hyphenated. Must match filename."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tempo_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 20,
        "maximum": 300
      },
      "description": "[min_bpm, max_bpm]"
    },
    "default_key": {
      "type": "string",
      "description": "e.g. 'D Dorian', 'C minor'"
    },
    "common_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scales": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mode/scale names: 'major', 'minor', 'dorian', 'phrygian', 'lydian', 'mixolydian', 'aeolian', 'locrian', 'minor_pentatonic', 'major_pentatonic', 'blues', 'harmonic_minor', 'melodic_minor'"
    },
    "chord_progressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "roman"
        ],
        "properties": {
          "roman": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Roman numerals: 'i', 'i7', 'i9', 'V7', 'iiø7', 'bVI', etc. Lowercase = minor, UPPERCASE = major. Suffixes: 7, 9, 11, 13 for extensions; ø = half-dim; ° = dim; b/# for chromatic."
          },
          "weight": {
            "type": "number",
            "default": 1.0
          },
          "source": {
            "type": "string"
          },
          "bars_per_chord": {
            "type": "number",
            "default": 1.0
          },
          "name": {
            "type": "string",
            "description": "Addressable by section 'progression' bindings"
          }
        }
      }
    },
    "voicing_style": {
      "type": "string",
      "enum": [
        "triads",
        "extended_7th_9th",
        "power_chords",
        "open_voicings",
        "stab",
        "sustained"
      ],
      "default": "triads"
    },
    "drum_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kick": {
            "type": "string",
            "description": "16-step grid: 'x' hit, '.' rest, 'g' ghost. Length determines resolution (8/16/32 steps)."
          },
          "snare": {
            "type": "string"
          },
          "hh": {
            "type": "string",
            "description": "Closed hi-hat"
          },
          "oh": {
            "type": "string",
            "description": "Open hi-hat"
          },
          "clap": {
            "type": "string"
          },
          "perc": {
            "type": "string",
            "description": "Extra percussion (rim, cowbell, etc)"
          },
          "swing": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 0.75,
            "default": 0.5
          },
          "ghost_density": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 0.0
          },
          "weight": {
            "type": "number",
            "default": 1.0
          },
          "kick_follow": {
            "type": "boolean",
            "description": "Kick doubles the rhythm guitar's low attacks instead of the grid."
          },
          "feel": {
            "type": "string",
            "description": "Informational: straight, halftime, double_time, blast"
          },
          "lanes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Extra lanes (also accepted as top-level keys)."
          }
        },
        "additionalProperties": {
          "type": "string",
          "description": "Any other lane grid: crash, crash_2, china, ride, ride_bell, ride_edge, splash, tom_high, tom_mid, tom_low, floor_tom, snare_rimshot, snare_sidestick, hh_tight, hh_pedal, cowbell, tambourine, shaker. Chars: x hit, . rest, g ghost, a accent. Length 8/12/16/24/32 sets resolution."
        }
      }
    },
    "song_sections": {
      "type": "array",
      "description": "Default song sections for this genre. Each may have micro-sections (verse.A, verse.B, chorus.drop) for nuanced addressing.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "bars"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "intro",
              "verse",
              "pre-chorus",
              "chorus",
              "post-chorus",
              "drop",
              "build",
              "bridge",
              "break",
              "breakdown",
              "pre-breakdown",
              "stop",
              "solo",
              "interlude",
              "outro",
              "loop"
            ]
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          },
          "density": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 0.7
          },
          "note": {
            "type": "string"
          },
          "micro": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "bars"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Sub-block label: 'A', 'B', 'drop', 'break'"
                },
                "bars": {
                  "type": "integer",
                  "minimum": 1
                },
                "density": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "note": {
                  "type": "string"
                },
                "energy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "How hard (0-1), independent of density (how busy). A breakdown is low density, high energy. Scales velocities; defaults to density."
                },
                "drum_pattern": {
                  "description": "Drum pattern name, or a list played one per phrase (fills.phrase_bars).",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "progression": {
                  "description": "Chord progression name or index, or a list to choose from (weighted).",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "integer"
                        ]
                      }
                    }
                  ]
                },
                "scale": {
                  "type": "string",
                  "description": "Per-section scale override (e.g. phrygian verse, minor chorus)."
                },
                "riff_style": {
                  "type": "string",
                  "description": "rhythm_guitar style here: pedal_tone, gallop, chug, open_chords, tremolo, power_strum, clean_arp"
                },
                "bass_style": {
                  "type": "string",
                  "description": "bass style here: sustained_root, walking, kick_locked, doubled, root_eighths, octave, arpeggio"
                },
                "melody_style": {
                  "type": "string",
                  "description": "melody/lead style here: pentatonic_sparse, fast_arpeggio, stab, sustained_hook, harmonized_thirds, riff_octave, tremolo_lead"
                },
                "voicing": {
                  "type": "string",
                  "enum": [
                    "triads",
                    "extended_7th_9th",
                    "power_chords",
                    "open_voicings",
                    "stab",
                    "sustained"
                  ]
                },
                "fill": {
                  "type": "boolean",
                  "description": "false disables phrase-end fills here; true forces one at the section end."
                },
                "stop": {
                  "type": "boolean",
                  "description": "One hit on beat 1, then silence."
                },
                "mute": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "drums",
                      "rhythm_guitar",
                      "bass",
                      "chords",
                      "melody",
                      "pad",
                      "lead",
                      "fx"
                    ]
                  },
                  "description": "Roles silent in this section."
                },
                "crash": {
                  "type": "boolean",
                  "description": "false suppresses the downbeat crash; true forces one on a micro-section downbeat."
                },
                "kick_follow": {
                  "type": "boolean",
                  "description": "Kick doubles the rhythm guitar's low attacks."
                }
              }
            }
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How hard (0-1), independent of density (how busy). A breakdown is low density, high energy. Scales velocities; defaults to density."
          },
          "drum_pattern": {
            "description": "Drum pattern name, or a list played one per phrase (fills.phrase_bars).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "progression": {
            "description": "Chord progression name or index, or a list to choose from (weighted).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            ]
          },
          "scale": {
            "type": "string",
            "description": "Per-section scale override (e.g. phrygian verse, minor chorus)."
          },
          "riff_style": {
            "type": "string",
            "description": "rhythm_guitar style here: pedal_tone, gallop, chug, open_chords, tremolo, power_strum, clean_arp"
          },
          "bass_style": {
            "type": "string",
            "description": "bass style here: sustained_root, walking, kick_locked, doubled, root_eighths, octave, arpeggio"
          },
          "melody_style": {
            "type": "string",
            "description": "melody/lead style here: pentatonic_sparse, fast_arpeggio, stab, sustained_hook, harmonized_thirds, riff_octave, tremolo_lead"
          },
          "voicing": {
            "type": "string",
            "enum": [
              "triads",
              "extended_7th_9th",
              "power_chords",
              "open_voicings",
              "stab",
              "sustained"
            ]
          },
          "fill": {
            "type": "boolean",
            "description": "false disables phrase-end fills here; true forces one at the section end."
          },
          "stop": {
            "type": "boolean",
            "description": "One hit on beat 1, then silence."
          },
          "mute": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "drums",
                "rhythm_guitar",
                "bass",
                "chords",
                "melody",
                "pad",
                "lead",
                "fx"
              ]
            },
            "description": "Roles silent in this section."
          },
          "crash": {
            "type": "boolean",
            "description": "false suppresses the downbeat crash; true forces one on a micro-section downbeat."
          },
          "kick_follow": {
            "type": "boolean",
            "description": "Kick doubles the rhythm guitar's low attacks."
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "drums",
              "rhythm_guitar",
              "bass",
              "chords",
              "melody",
              "pad",
              "lead",
              "fx"
            ]
          },
          "gm": {
            "type": "string",
            "description": "GM instrument slug from midi_types/gm_instruments.py. Null/absent for drums."
          },
          "register": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          },
          "style": {
            "type": "string",
            "description": "Playing style. drums: free-form. rhythm_guitar: pedal_tone, gallop, chug, open_chords, tremolo, power_strum, clean_arp. bass: sustained_root, walking, kick_locked (sub_808*), doubled, root_eighths, octave, arpeggio. chords/pad: stab, sustained, sparse_held, strum8, pulse4. melody/lead: pentatonic_sparse, fast_arpeggio, stab, sustained_hook, harmonized_thirds, riff_octave, tremolo_lead."
          },
          "velocity_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "vst": {
            "type": "string",
            "description": "Instrument map slug from instruments/ (superior-drummer-3, odin-iii, gm-drums, ...). Any VST works with any genre; --vst role=slug overrides."
          },
          "voicing": {
            "type": "string",
            "enum": [
              "triads",
              "extended_7th_9th",
              "power_chords",
              "open_voicings",
              "stab",
              "sustained"
            ]
          },
          "double_track": {
            "type": "boolean",
            "description": "Render hard-panned L/R takes with independent humanization."
          },
          "articulations": {
            "type": "object",
            "description": "Role articulation settings, e.g. {pinch_harmonic_rate: 0.04}"
          }
        }
      }
    },
    "velocity_ranges": {
      "type": "object",
      "description": "Optional per-role overrides keyed by role name.",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "2-4 distilled human-readable principles that define the genre. Drives composer behavior + agent self-evaluation."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artist": {
            "type": "string"
          },
          "song": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "research_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sound_design": {
      "type": "object",
      "description": "Forward-compat. Synth presets, drum sample paths, FX chains. Currently informational; composers ignore it.",
      "properties": {
        "synth_presets": {
          "type": "object"
        },
        "drum_samples": {
          "type": "object"
        },
        "fx_chain": {
          "type": "array"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "tuning": {
      "description": "Guitar tuning for riff/bass pedal notes: a name (standard_e, drop_d, drop_c, drop_b, drop_a, seven_b, seven_drop_a, eight_f#, eight_drop_e, double_drop_c, standard_d, standard_c), a list of open-string MIDI pitches, or {name, strings}.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "object"
        }
      ]
    },
    "layer_order": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "drums",
          "rhythm_guitar",
          "bass",
          "chords",
          "melody",
          "pad",
          "lead",
          "fx"
        ]
      },
      "description": "Render order. Default chords, pad, rhythm_guitar, drums, bass, melody, lead. Riff genres put rhythm_guitar first so kick/bass lock to it."
    },
    "form": {
      "type": "array",
      "description": "Song form template, rendered with --form (or truncated by --bars > 8).",
      "items": {
        "type": "object",
        "required": [
          "section"
        ],
        "properties": {
          "section": {
            "type": "string",
            "description": "song_sections name"
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "<1 = optional slot, rolled with the seed"
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How hard (0-1), independent of density (how busy). A breakdown is low density, high energy. Scales velocities; defaults to density."
          },
          "drum_pattern": {
            "description": "Drum pattern name, or a list played one per phrase (fills.phrase_bars).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "progression": {
            "description": "Chord progression name or index, or a list to choose from (weighted).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            ]
          },
          "scale": {
            "type": "string",
            "description": "Per-section scale override (e.g. phrygian verse, minor chorus)."
          },
          "riff_style": {
            "type": "string",
            "description": "rhythm_guitar style here: pedal_tone, gallop, chug, open_chords, tremolo, power_strum, clean_arp"
          },
          "bass_style": {
            "type": "string",
            "description": "bass style here: sustained_root, walking, kick_locked, doubled, root_eighths, octave, arpeggio"
          },
          "melody_style": {
            "type": "string",
            "description": "melody/lead style here: pentatonic_sparse, fast_arpeggio, stab, sustained_hook, harmonized_thirds, riff_octave, tremolo_lead"
          },
          "voicing": {
            "type": "string",
            "enum": [
              "triads",
              "extended_7th_9th",
              "power_chords",
              "open_voicings",
              "stab",
              "sustained"
            ]
          },
          "fill": {
            "type": "boolean",
            "description": "false disables phrase-end fills here; true forces one at the section end."
          },
          "stop": {
            "type": "boolean",
            "description": "One hit on beat 1, then silence."
          },
          "mute": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "drums",
                "rhythm_guitar",
                "bass",
                "chords",
                "melody",
                "pad",
                "lead",
                "fx"
              ]
            },
            "description": "Roles silent in this section."
          },
          "crash": {
            "type": "boolean",
            "description": "false suppresses the downbeat crash; true forces one on a micro-section downbeat."
          },
          "kick_follow": {
            "type": "boolean",
            "description": "Kick doubles the rhythm guitar's low attacks."
          }
        }
      }
    },
    "fills": {
      "type": "object",
      "description": "Phrase-end drum fills.",
      "properties": {
        "phrase_bars": {
          "type": "integer",
          "minimum": 1
        },
        "probability": {
          "type": "number"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "snare_roll",
              "tom_run",
              "triplet_toms",
              "kick_snare_burst",
              "snare_build",
              "open_hat",
              "drop_out",
              "stop_hit"
            ]
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "section_end_probability": {
          "type": "number"
        }
      }
    },
    "motif": {
      "type": "object",
      "description": "Repeat ideas with variation instead of re-rolling every bar.",
      "properties": {
        "bars": {
          "type": "integer",
          "minimum": 1
        },
        "variations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "exact",
              "last_bar",
              "last_half",
              "octave_drop",
              "last_root"
            ]
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "drums",
              "rhythm_guitar",
              "bass",
              "chords",
              "melody",
              "pad",
              "lead",
              "fx"
            ]
          }
        }
      }
    },
    "humanize": {
      "type": "object",
      "properties": {
        "timing": {
          "type": "number",
          "minimum": 0,
          "description": "max +/- beats"
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "description": "max +/- (0-1 scale)"
        }
      }
    }
  }
}
