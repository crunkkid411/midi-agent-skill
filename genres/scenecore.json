      ],
      "note": "Build: four-on-the-floor kick, snare build at the end",
      "automation": [
        {
          "param": "filter",
          "shape": "ramp_up",
          "roles": [
            "chords",
            "pad",
            "lead"
          ],
          "from": 0.3,
