{
  "name": "scenecore",
  "aliases": [
    "scene-core",
    "hyperpop-scenecore"
  ],
  "tempo_range": [
    135,
    160
  ],
  "default_key": "A minor",
  "common_keys": [
    "A minor",
    "E minor",
    "F# minor"
  ],
  "scales": [
    "minor",
    "harmonic_minor",
    "minor_pentatonic"
  ],
  "layer_order": [
    "chords",
    "drums",
    "bass",
    "pad",
    "melody",
    "lead"
  ],
  "chord_progressions": [
    {
      "name": "emo-loop",
      "roman": [
        "i",
        "VI",
        "III",
        "VII"
      ],
      "weight": 1.0,
      "bars_per_chord": 2.0,
      "source": "Common scenecore/emo-trap loop"
    },
    {
      "name": "two-chord-stab",
      "roman": [
        "i",
        "VI"
      ],
      "weight": 0.8,
      "bars_per_chord": 4.0,
      "source": "Two-chord stab loop"
    },
    {
      "name": "glossy",
      "roman": [
        "i9",
        "VI9"
      ],
      "weight": 0.4,
      "bars_per_chord": 4.0,
      "source": "Glossier hyperpop variant"
    },
    {
      "name": "build-climb",
      "roman": [
        "VI",
        "VII",
        "i",
        "V"
      ],
      "weight": 0.5,
      "bars_per_chord": 1.0,
      "source": "Riser into the drop — harmonic-minor V pulls back to i"
    }
  ],
  "voicing_style": "stab",
  "drum_patterns": [
    {
      "name": "trap-breakcore-140",
      "ghost_density": 0.15,
      "weight": 1.0,
      "kick": "x..x.x..x..x.x..",
      "snare": "....x.......x...",
      "hh": "xxxxxxxxxxxxxxxx",
      "clap": "....x.......x..."
    },
    {
      "name": "trap-hat-rolls",
      "weight": 0.7,
      "kick": "x.....x...x..x..",
      "clap": "........x.......",
      "hh": "x.x.x.x.x.x.x.x.x.x.x.x.xxxxxxxx",
      "oh": "..............x."
    },
    {
      "name": "breakcore-chop",
      "feel": "double_time",
      "weight": 0.5,
      "kick": "x.x...x...x.x...",
      "snare": "....x..x.x..x.xx",
      "hh": "x.x.x.x.x.x.x.x.",
      "crash": "x..............."
    },
    {
      "name": "halftime-drop",
      "feel": "halftime",
      "weight": 0.5,
      "kick": "x.......x.......",
      "snare": "........x.......",
      "hh": "x.x.x.x.x.x.x.x."
    },
    {
      "name": "build-four",
      "weight": 0.2,
      "kick": "x...x...x...x...",
      "clap": "....x.......x...",
      "hh": "..x...x...x...x."
    }
  ],
