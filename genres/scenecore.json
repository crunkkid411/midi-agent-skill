      "note": "Halftime breather at a slower tempo — pad and filtered stabs, kick on 1 and 3",
      "tempo_scale": 0.8,
      "automation": [
        {
          "param": "filter",
          "shape": "hold",
          "roles": [
            "chords",
            "pad"
          ],
          "value": 0.45,
          "reset": 1.0
        }
      ]
    },
    {
      "name": "outro",
      "bars": 4,
      "density": 0.3,
      "energy": 0.3,
      "progression": "two-chord-stab",
      "drum_pattern": "halftime-drop",
      "mute": [
        "lead"
      ],
      "fill": false,
      "note": "Strip to filtered chords, halftime feel",
      "automation": [
        {
          "param": "filter",
          "shape": "ramp_down",
          "roles": [
            "chords",
            "pad"
          ],
          "from": 0.15,
          "to": 1.0
