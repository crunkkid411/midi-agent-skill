  "principles": [
    "Jazz-rooted harmony with 7th/9th voicings and Dorian color (bIII, ii-V minor cycles)",
    "Laid-back boom-bap drums slightly behind the beat with ghost notes and 55-66% swing; rim/shaker variations",
    "Sparse, repeating pentatonic melody with lots of rests and space — the texture breathes",
    "Arrangement by subtraction — intro without drums, drops where the hats play alone, half-time bridge, filtered outro"
  ],
  "references": [
    { "artist": "Nujabes", "song": "Feather" },
    { "artist": "J Dilla", "song": "Donuts (Time, the Donut of the Heart)" },
    { "artist": "Idealism", "song": "both of us" }
  ],
  "research_sources": [
    "https://www.native-instruments.com/blogs/blog/lo-fi-hip-hop-beats (intro, loop that builds, breakdown where elements drop out)",
    "https://www.loopmasters.com/articles/4298-How-To-Make-Chilled-LoFi-Hip-Hop-Beats-Sounds-Samples-Loops (swung ghost notes, kick ghosts near bar end)",
    "https://violetrecording.com/how-to-make-lofi-beats/ (55-70% swing, 75-85 BPM sweet spot)",
    "https://beatkey.pages.dev/how-to-make-lofi-hip-hop-music (strip drums for a bridge, mute hats for a bar)"
  ],
  "sound_design": {
