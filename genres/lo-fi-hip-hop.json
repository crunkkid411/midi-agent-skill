      "snare": "....x.......x...",
      "hh":    "x.x.x.x.x.x.x.x.",
      "oh":    "............x..." },
    { "name": "boom-bap-rim", "swing": 0.6, "ghost_density": 0.35, "weight": 0.7,
      "kick":  "x......xx.......",
      "snare_sidestick": "....x.......x...",
      "hh":    "x.xgx.x.x.xgx.x.",
      "shaker": "..x...x...x...x." },
    { "name": "dilla-drag", "swing": 0.66, "ghost_density": 0.25, "weight": 0.5,
      "kick":  "x.....x..x..x...",
      "snare": "....x.......x..g",
      "hh":    "x.x.x.x.x.x.x.x." },
    { "name": "halftime-dusty", "swing": 0.6, "ghost_density": 0.4, "weight": 0.6,
      "kick":  "x.......x.......",
      "snare": "........x.......",
      "hh":    "x.x.x.x.x.x.x.x." },
    { "name": "hats-only", "swing": 0.6, "weight": 0.1,
      "hh":    "x.x.x.x.x.x.x.x.",
      "kick":  "x..............." }
  ],
  "fills": {
    "phrase_bars": 4,
    "probability": 0.35,
    "types": ["drop_out", "open_hat", "snare_roll"],
    "beats": [1.0],
    "section_end_probability": 0.7
  },
  "motif": {
    "bars": 2,
    "variations": ["exact", "last_bar", "exact", "last_half"],
    "roles": ["melody", "lead"]
  },
  "humanize": { "timing": 0.03, "velocity": 0.06 },
  "song_sections": [
    {
      "name": "intro", "bars": 4, "density": 0.4, "energy": 0.3,
      "progression": "intro-hold", "mute": ["drums", "bass", "melody"],
      "note": "Filtered chords, vinyl crackle, no drums",
      "micro": []
    },
    {
      "name": "loop", "bars": 8, "density": 0.75, "energy": 0.6,
      "progression": ["feather-cycle", "minor-ii-v", "two-chord-vamp"],
      "micro": [
        { "name": "A", "bars": 4, "density": 0.7, "mute": ["melody", "pad"],
          "drum_pattern": ["boom-bap-lazy", "boom-bap-rim"], "note": "Drums + bass + chords, no melody" },
        { "name": "B", "bars": 4, "density": 0.85, "note": "Add the melodic lead and a warm pad" }
      ]
    },
    {
      "name": "bridge", "bars": 4, "density": 0.55, "energy": 0.45,
      "progression": "bridge-lift", "drum_pattern": "halftime-dusty", "scale": "aeolian",
      "bass_style": "walking",
      "note": "Half-time break, chords open up, bass walks"
    },
    {
      "name": "break", "bars": 2, "density": 0.35, "energy": 0.3,
      "drum_pattern": "hats-only", "mute": ["bass", "melody"], "fill": false,
      "note": "Drums and bass drop out — just hats and chords before the loop returns"
    },
    {
      "name": "outro", "bars": 4, "density": 0.3, "energy": 0.25,
      "progression": "intro-hold", "drum_pattern": "halftime-dusty", "mute": ["melody"],
      "note": "Strip to chords + filtered drums"
    }
