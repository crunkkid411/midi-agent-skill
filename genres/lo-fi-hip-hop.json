  "scales": ["dorian", "minor_pentatonic", "minor"],
  "layer_order": ["chords", "drums", "bass", "pad", "melody", "lead"],
  "chord_progressions": [
    { "name": "feather-cycle", "roman": ["i9", "iv9", "iiø7", "V7b9"], "weight": 1.0, "bars_per_chord": 1.0,
      "source": "Nujabes - Feather (jazz minor cycle)" },
    { "name": "minor-ii-v", "roman": ["i7", "VI7", "ii7", "V7"], "weight": 0.7, "bars_per_chord": 1.0,
      "source": "Common ii-V minor cycle" },
    { "name": "two-chord-vamp", "roman": ["i9", "IV9"], "weight": 0.6, "bars_per_chord": 2.0,
      "source": "Two-chord Dorian chillhop vamp (i9 - IV9)" },
    { "name": "bridge-lift", "roman": ["VI9", "VII9", "i9", "i9"], "weight": 0.4, "bars_per_chord": 1.0,
      "source": "Bridge lift through bVI and bVII back to the tonic" },
    { "name": "intro-hold", "roman": ["i9", "IV9"], "weight": 0.2, "bars_per_chord": 2.0,
      "source": "Filtered intro vamp" }
  ],
  "voicing_style": "extended_7th_9th",
  "drum_patterns": [
    { "name": "boom-bap-lazy", "swing": 0.58, "ghost_density": 0.3, "weight": 1.0,
